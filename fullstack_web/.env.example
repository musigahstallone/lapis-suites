# Server Configuration
NODE_ENV=development
PORT=3001
APP_BASE_URL=https://your-domain.co.ke
CORS_ORIGINS=https://your-domain.co.ke
MONGODB_URI=mongodb://127.0.0.1:27017/propmanager

# Cryptographically strong random JWT signing secret (at least 64 hex chars: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=replace_with_64_char_random_hex_secret

# KCB Buni API Integration (M-Pesa STK Push)
KCB_BASE_URL=https://uat.buni.kcbgroup.com
KCB_CONSUMER_KEY=your_kcb_consumer_key
KCB_CONSUMER_SECRET=your_kcb_consumer_secret
KCB_DEFAULT_ROUTE_CODE=207
# Register callback URL with secret path segment when possible: https://your-domain.co.ke/api/kcb/callback/<KCB_WEBHOOK_SECRET>
KCB_CALLBACK_URL=https://your-domain.co.ke/api/kcb/callback
KCB_WEBHOOK_SECRET=replace_with_32_byte_random_webhook_secret
# Set to true once KCB is configured to send KCB_WEBHOOK_SECRET in callback URL path/query/header
KCB_CALLBACK_STRICT=false

# MobileSasa SMS Gateway (Admin emails, phones, and rent due date are managed in App Settings)
MOBILESASA_BASE_URL=https://api.mobilesasa.com
MOBILESASA_TOKEN=mbs_your_api_token_here
MOBILESASA_SENDER_ID=MOBILESASA
MOBILESASA_CALLBACK_URL=https://your-domain.co.ke/api/sms/dlr
MOBILESASA_WEBHOOK_SECRET=your_mobilesasa_webhook_secret
